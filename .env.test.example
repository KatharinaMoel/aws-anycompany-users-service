# Copy to .env.test and fill in. .env.test is gitignored: it holds a real,
# if disposable, password.
#
# The first four values come from the Terraform outputs, run from infrastructure/:
#
#   terraform output -raw api_invoke_url
#   terraform output -raw app_client_id
#   terraform output -raw user_pool_id
#
# The test user is created with the two aws cognito-idp commands in README.md.
# scripts/e2e.sh and the demo client read this file.

TEST_USER_EMAIL='you@example.com'
TEST_USER_PASSWORD='ChangeMe123!'
USER_POOL_ID='us-west-2_xxxxxxxxx'
APP_CLIENT_ID='xxxxxxxxxxxxxxxxxxxxxxxxxx'
API_INVOKE_URL='https://xxxxxxxxxx.execute-api.us-west-2.amazonaws.com/prod'
